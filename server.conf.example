# Пример конфигурации адреса сервера для КЛИЕНТА.
# Скопируйте этот файл в server.conf рядом с клиентом (или в корень проекта)
# и впишите IP-адрес компьютера-сервера в локальной сети.
#
#   cp server.conf.example server.conf
#
# Альтернатива: задать переменные окружения TIMP_SERVER_HOST и TIMP_SERVER_PORT
# (скрипт run-client.sh делает это автоматически).

host=192.168.1.50
port=33333
