@startuml
left to right direction
skinparam packageStyle rectangle

actor "Неавторизованный пользователь" as Unauth
actor "Авторизованный пользователь" as AuthUser
actor "Email-сервис (SMTP)" as Email
actor "PuTTY / Telnet" as Telnet

rectangle "Система 2FA" {
  usecase "Зарегистрироваться" as UC_Reg
  usecase "Войти в систему" as UC_Login
  usecase "Подтвердить email-код" as UC_Verify
  usecase "Запросить сброс пароля" as UC_ResetReq
  usecase "Установить новый пароль" as UC_SetNewPwd
  usecase "Построить график функции" as UC_Graph
  usecase "Выйти из системы" as UC_Logout
  usecase "Отправить OTP-код" as UC_SendEmail
}

UC_Login ..> UC_Verify : <<include>>
UC_Reg ..> UC_Verify : <<include>>
UC_ResetReq ..> UC_Verify : <<include>>
UC_ResetReq ..> UC_SetNewPwd : <<include>>
UC_Verify <|-- UC_VerifyBlock : <<extend>><br>(блокировка)

Unauth --> UC_Reg
Unauth --> UC_Login
Unauth --> UC_ResetReq
AuthUser --> UC_Graph
AuthUser --> UC_Logout
Email --> UC_SendEmail
Telnet --> UC_Login
Telnet --> UC_Reg
@enduml